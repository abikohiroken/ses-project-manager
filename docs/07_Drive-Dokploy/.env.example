# Application
NODE_ENV=production
APP_URL=
AUTH_SECRET=
AUTH_TRUST_HOST=true
TZ=Asia/Tokyo

# Google OAuth（利用者ログイン用。下のサービスアカウントとは別物）
# 設計差分v1.2 §7 で追加。認証は next-auth v4.24.15（同 §13）
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
# v4 がコールバックURLを組み立てるために必要。APP_URL と同じ値を入れる
NEXTAUTH_URL=

# Database
DATABASE_URL=

# Google サービスアカウント（Sheets / Drive API用）
GOOGLE_PROJECT_ID=
GOOGLE_CLIENT_EMAIL=
GOOGLE_PRIVATE_KEY=
GOOGLE_SHEETS_SPREADSHEET_ID=
GOOGLE_DRIVE_ROOT_FOLDER_ID=
GOOGLE_DRIVE_INBOX_FOLDER_ID=
GOOGLE_DRIVE_PROCESSED_FOLDER_ID=
GOOGLE_DRIVE_ERROR_FOLDER_ID=

# LINE
LINE_CHANNEL_SECRET=
LINE_CHANNEL_ACCESS_TOKEN=

# Internal
CRON_SECRET=
CSV_SCHEMA_VERSION=v1
CHATGPT_PROMPT_VERSION=PROJECT-PARSER-1

# Seed
INITIAL_ADMIN_EMAIL=
INITIAL_ADMIN_NAME=
